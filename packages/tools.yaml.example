# tools.yaml.example — reference syntax for berserk tool entries.
#
# Drop this in your config dir as `tools.yaml` (or any other *.yaml/*.yml
# name except `config.yaml`) to have berserk load it. The `.example`
# extension means berserk SKIPS this file — copy what you need into a real
# catalog file.
#
# Names referenced in `profiles:` and `category:` MUST be declared in
# profiles.yaml and categories.yaml respectively. Validation runs on every
# load and accumulates every problem at once.

tools:
  # ─────────────────────────────────────────────────────────────────────
  # Field reference — every key annotated.
  # ─────────────────────────────────────────────────────────────────────
  - name: example-tool                # REQUIRED — canonical name; usually the binary on $PATH
    description: "One-line summary"   # OPTIONAL — shown in `list`, `search`, `info`
    category: [recon, web]            # OPTIONAL — must reference categories.yaml entries
    profiles: [recon, red-team]       # OPTIONAL — must reference profiles.yaml entries
    aliases: [exa, ext]               # OPTIONAL — `berserk install exa` resolves to example-tool
    installer: pipx                   # REQUIRED — pipx | go | cargo | gem | npm | binary | system | custom | git
    repo: owner/example-tool          # installer-specific (see below) — always GitHub owner/name
    branch: main                      # OPTIONAL — git-only; defaults to repo default branch
    package: example-tool             # installer-specific (see below)
    depends:                          # OPTIONAL — system packages required to install/run
      arch: [openssl, pkgconf]        # pacman packages
      debian: [libssl-dev, pkg-config] # apt packages

  # ─────────────────────────────────────────────────────────────────────
  # pipx — Python tools. Either `repo` (installs from git+https://github.com/...)
  # or `package` (installs from PyPI). `repo` wins if both are set.
  # ─────────────────────────────────────────────────────────────────────
  - name: netexec
    description: "Swiss army knife for network protocols"
    category: [ad, lateral-movement, recon]
    profiles: [ad-attacks]
    aliases: [nxc]
    installer: pipx
    repo: Pennyw0rth/NetExec           # → git+https://github.com/Pennyw0rth/NetExec
    depends:
      arch: [openssl, pkgconf]
      debian: [libssl-dev, pkg-config]

  - name: theharvester
    description: "Email/subdomain harvester"
    category: [recon, osint]
    profiles: [recon, osint]
    installer: pipx
    package: theharvester              # → installs from PyPI
    python_version: "3.11"             # OPTIONAL — pipx --python python3.11

  # ─────────────────────────────────────────────────────────────────────
  # go — `go install <pkg>@latest`. Either `repo` (full module path) or
  # `package`. `repo` is just the module path; @latest is appended.
  # ─────────────────────────────────────────────────────────────────────
  - name: nuclei
    description: "Template-based vulnerability scanner"
    category: [web, recon]
    profiles: [web, recon]
    installer: go
    repo: projectdiscovery/nuclei/v3/cmd/nuclei

  # ─────────────────────────────────────────────────────────────────────
  # cargo — `cargo install <pkg>`. `package` defaults to `name`.
  # ─────────────────────────────────────────────────────────────────────
  - name: rustscan
    description: "Modern fast port scanner"
    category: [recon]
    profiles: [recon]
    installer: cargo
    # package: rustscan   # implicit — defaults to `name`

  # ─────────────────────────────────────────────────────────────────────
  # gem — `gem install <pkg>`. `package` defaults to `name`.
  # ─────────────────────────────────────────────────────────────────────
  - name: evil-winrm
    description: "WinRM shell for pentesting Windows targets"
    category: [ad, post-exploitation]
    profiles: [ad-attacks]
    installer: gem

  # ─────────────────────────────────────────────────────────────────────
  # npm — `npm install -g <pkg>`. `package` defaults to `name`.
  # ─────────────────────────────────────────────────────────────────────
  - name: retire
    description: "Scanner for known-vulnerable JS libraries"
    category: [web]
    profiles: [web]
    installer: npm
    package: "@google/gemini" # if not specified defaults to name

  # ─────────────────────────────────────────────────────────────────────
  # binary — pulls a release asset from GitHub. Needs `repo` and almost
  # always `asset_pattern` (substring match against asset names).
  # ─────────────────────────────────────────────────────────────────────
  - name: linpeas
    description: "Linux privilege escalation auditing"
    category: [post-exploitation, privesc]
    profiles: [privesc, post-exploitation]
    installer: binary
    repo: peass-ng/PEASS-ng
    asset_pattern: "linpeas.sh"        # substring; "linux-amd64", ".tar.gz" also work

  # ─────────────────────────────────────────────────────────────────────
  # system — distro package manager. Falls through to pacman / apt-get.
  # `arch_package` and `debian_package` override `name` per-distro.
  # ─────────────────────────────────────────────────────────────────────
  - name: nmap
    description: "Network discovery and security auditing"
    category: [recon]
    profiles: [recon]
    installer: system
    # arch_package: nmap        # implicit — defaults to `name`
    # debian_package: nmap      # implicit — defaults to `name`

  - name: john
    description: "John the Ripper password cracker"
    category: [password-attacks, credentials]
    profiles: [password-attacks, credentials]
    installer: system
    arch_package: john           # explicit when distro names diverge
    debian_package: john-jumbo

  # ─────────────────────────────────────────────────────────────────────
  # custom — runs a supplied install command through `sh -c`.
  # Use when crafting custom install steps for a tool
  # `steps` is REQUIRED with this installer.
  # Update re-runs the same command. Remove is manual (no uninstall path).
  # ─────────────────────────────────────────────────────────────────────
  - name: bloodhound
    description: "AD attack path mapping and visualization"
    category: [ad]
    profiles: [ad-attacks]
    installer: custom
    steps:
      - "wget https://github.com/SpecterOps/bloodhound-cli/releases/latest/download/bloodhound-cli-linux-amd64.tar.gz -O /tmp/bloodhound-cli-linux-amd64.tar.gz"
      - "tar -xzf /tmp/bloodhound-cli-linux-amd64.tar.gz -C /tmp"
      - "sudo mv /tmp/bloodhound-cli /usr/local/bin/"

  # ─────────────────────────────────────────────────────────────────────
  # git — clones a repo into /opt/berserk/<name>. Needs `repo` (GitHub
  # owner/repo shorthand or a full URL). `branch` is optional and
  # defaults to the repo's default branch.
  # Update runs `git pull --ff-only`. Remove deletes the cloned dir.
  # Run `berserk doctor` first — it creates /opt/berserk and chowns it
  # to the current user so no sudo is needed for clone/pull/remove.
  #
  # For repos that are bare Python scripts (no setup.py / pyproject.toml),
  # add `entry_scripts` (list) and `runtime: python`. berserk will:
  #   1. Create a venv at /opt/berserk/venvs/<name>
  #   2. Install deps from requirements.txt (if present) AND pip_deps (if any)
  #   3. Write one shim per script: foo.py → /opt/berserk/bin/foo
  # berserk doctor also creates /opt/berserk/bin and adds it to PATH.
  # ─────────────────────────────────────────────────────────────────────

  # Plain git clone — no script invocation needed (pre-built binaries, .NET assemblies, etc.)
  - name: sharpcollection
    description: "Precompiled .NET offensive tools (Seatbelt, SharpHound, Rubeus, etc.)"
    category: [post-exploitation, exploitation, ad]
    profiles: [post-exploitation, ad-attacks]
    installer: git
    repo: flangvik/SharpCollection      # → https://github.com/flangvik/SharpCollection
    # branch: main                      # optional — pin a specific branch or tag
    # repo: https://gitlab.com/org/repo # full URLs are also accepted

  # git + Python script — single bare .py tool with a requirements.txt
  - name: targetedkerberoast
    description: "Kerberoast accounts with no SPN set by adding a temporary SPN, then removing it"
    category: [ad, credentials, password-attacks]
    profiles: [ad-attacks]
    installer: git
    repo: ShutdownRepo/targetedKerberoast
    entry_scripts: [targetedKerberoast.py]  # each entry gets its own shim: foo.py → /opt/berserk/bin/foo
    runtime: python                         # REQUIRED when entry_scripts is set; only python supported
    # pip_deps: [impacket, ldap3]           # additive on top of requirements.txt

  # git + Python script — multiple scripts from one repo
  - name: pkinittools
    description: "Python tools for Kerberos PKINIT and certificate-based authentication"
    category: [ad, credentials]
    profiles: [ad-attacks]
    installer: git
    repo: dirkjanm/PKINITtools
    entry_scripts: [gettgtpkinit.py, gets4uticket.py, getnthash.py]
    runtime: python
    # pip_deps: [minikerberos, impacket]
